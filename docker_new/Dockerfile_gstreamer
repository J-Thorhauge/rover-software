# Create symbolic link for libv4l2
RUN ln -sf /usr/lib/aarch64-linux-gnu/tegra/libv4l2.so.0 /usr/lib/aarch64-linux-gnu/libv4l2.so

# Clone and build zedsrc GStreamer plugin
RUN git clone https://github.com/stereolabs/zed-gstreamer.git /opt/zed-gstreamer && \
    cd /opt/zed-gstreamer && mkdir build && cd build && \
    cmake .. && make && make install && ldconfig

