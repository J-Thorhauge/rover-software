
ARG L4T_VERSION_MAJOR=36
ARG L4T_VERSION_MINOR=4
ARG L4T_VERSION_PATCH=0
ARG L4T_VERSION=${L4T_VERSION_MAJOR}.${L4T_VERSION_MINOR}.${L4T_VERSION_PATCH}

FROM nvcr.io/nvidia/l4t-jetpack:r${L4T_VERSION} AS base

ARG DEBIAN_FRONTEND=noninteractive

# Install GStreamer and dependencies
RUN apt-get update && apt-get install -y \
    libgstreamer1.0-dev \
    gstreamer1.0-tools \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav \
    libgstrtspserver-1.0-dev \
    libv4l-dev \
    git \
    cmake \
    build-essential \
    wget \
    zstd \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Set up environment variables
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV PYTHONIOENCODING=utf-8

# Install ZED SDK
ARG ZED_SDK_MAJOR=5
ARG ZED_SDK_MINOR=0
ARG ZED_SDK_PATCH=3
ARG ZED_SDK_VERSION=${ZED_SDK_MAJOR}.${ZED_SDK_MINOR}.${ZED_SDK_PATCH}


RUN wget -q --no-check-certificate -O /opt/ZED_SDK_Linux.run https://download.stereolabs.com/zedsdk/5.0.3/l4t36.4/jetsons
RUN chmod +x /opt/ZED_SDK_Linux.run



