<root main_tree_to_execute="AckermannTurnTree">
  <BehaviorTree ID="AckermannTurnTree">

    <!--
      If the robot needs to turn sharply, handle it with steering + spin sequence.
      Otherwise, navigate normally.
    -->
    <Fallback name="HandleTurnIfNeeded">

      <!-- Turn-on-spot sequence -->
      <Sequence name="TurnOnSpotSequence">

        <!-- Check if a large heading change is required -->
        <ScriptCondition
          name="NeedsLargeTurn"
          code="
            function yaw(q)
              siny_cosp = 2.0 * (q.w * q.z + q.x * q.y)
              cosy_cosp = 1.0 - 2.0 * (q.y * q.y + q.z * q.z)
              return math.atan2(siny_cosp, cosy_cosp)
            end
            curr_yaw = yaw(current_pose.orientation)
            goal_yaw = yaw(goal.orientation)
            return math.abs(curr_yaw - goal_yaw) > 0.6
          "/>

        <!-- Step 1: Turn wheels to spin configuration -->
        <SetSteering target="turn_on_spot"/>

        <!-- Step 2: Wait for steering actuators -->
        <Wait delay="0.5"/>

        <!-- Step 3: Rotate robot on the spot -->
        <RotateInPlace angular_speed="0.8"/>

        <!-- Step 4: Restore steering to straight driving -->
        <SetSteering target="straight"/>

      </Sequence>

      <!-- If no large turn is needed, proceed with normal navigation -->
      <NavigateToPose/>

    </Fallback>

  </BehaviorTree>
</root>

